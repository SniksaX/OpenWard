APP_SECRET=
APP_ENV=
TRUSTED_PROXY=
# Dev-only. Next.js output:'export' cannot proxy /api, so the browser calls
# http://127.0.0.1:4444 cross-origin. Echo this exact origin (never "*") because
# Authorization is sent. 127.0.0.1 and localhost are different origins — list
# both if you use either. Unset in production — Go serves ./dist same-origin.
# CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
CORS_ORIGIN=
DB_PATH=/data/database.db
WG_SERVER_PRIVATE_KEY=
WG_SERVER_PUBLIC_KEY=
WG_SERVER_ENDPOINT=
# Public WAN interface used in wg0 PostUp MASQUERADE (default ens3).
WG_EGRESS_IFACE=ens3
# Directory of the Next.js static export. Default ./dist (see Makefile `dist`).
SERVE_DIR=
